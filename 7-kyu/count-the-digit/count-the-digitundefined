class CountDig
{
public:
    static int nbDig(int n, int d) {
        int count = 0;
​
        for(int i = 0;i<= n;i++){
            int k=i*i;
​
            if(k==0&& d == 0){
                count++;
            }
​
            while(k >0){
                if(k % 10 == d) {
                    count++;
                }
                k /= 10;
            }
        }
​
        return count;
    }
};